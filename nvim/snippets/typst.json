{
    "typ": {
        "prefix": "typ",
        "body": [
            "#import \"@preview/codly:1.3.0\": codly, codly-init",
            "#show: codly-init.with()",
            "",
            "#import \"@preview/codly-languages:0.1.8\": codly-languages",
            "#codly(languages: codly-languages)",
            "",
            "#import \"@preview/ctheorems:1.1.3\": thmrules",
            "#show: thmrules",
            "",
            "#import \"@preview/itemize:0.2.0\" as el",
            "#show: el.default-enum",
            "#show: el.default-list.with(label-baseline: 0.05em)",
            "",
            "#show heading: it => {",
            "  it",
            "  v(12pt, weak: true)",
            "}",
            "",
            "#show raw.line: set text(font: \"JetBrainsMono NFP\")",
            "",
            "#set text(",
            "  10pt,",
            "  font: (",
            "    (name: \"Charter\", covers: \"latin-in-cjk\"),",
            "    \"Source Han Serif SC\",",
            "  ),",
            "  top-edge: \"bounds\",",
            ")",
            "",
            "#set math.equation(numbering: \"(1)\")",
            "",
            "#set page(numbering: \"1\")",
            "",
            "#set par(justify: true, linebreaks: \"optimized\", leading: 0.95em)",
            "",
            "#set smartquote(enabled: false)",
            "",
            "#align(center, [",
            "  #set text(18pt, weight: \"bold\")",
            "  ${1}",
            "])",
            "",
            "#outline()",
            "",
            "$0"
        ]
    },
    "lib": {
        "prefix": "lib",
        "body": [
            "#import \"@preview/ctheorems:1.1.3\": thmenv, thmproof",
            "#import \"@preview/showybox:2.0.4\": showybox",
            "",
            "#let blockquote(cite: none, body) = [",
            "  #set text(size: 0.98em)",
            "  #pad(left: 1.5em)[",
            "    #block(",
            "      breakable: true,",
            "      width: 100%,",
            "      fill: gray.lighten(90%),",
            "      radius: (left: 0pt, right: 5pt),",
            "      stroke: (left: 5pt + gray, rest: 1pt + silver),",
            "      inset: 1em,",
            "    )[#body]",
            "  ]",
            "]",
            "",
            "#let theorem = thmenv(",
            "  \"Theorem\",",
            "  none,",
            "  none,",
            "  (name, number, body, ..args) => {",
            "    showybox(",
            "      frame: (",
            "        border-color: blue,",
            "        title-color: blue.lighten(30%),",
            "        body-color: blue.lighten(95%),",
            "        footer-color: blue.lighten(80%),",
            "      ),",
            "      title: [*Theorem #number #if name not in (none, [], \"\") { [ (#name)] }*],",
            "      ..args.named(),",
            "      body,",
            "    )",
            "  },",
            ").with(numbering: \"1\")",
            "",
            "#let definition = thmenv(",
            "  \"Definition\",",
            "  none,",
            "  none,",
            "  (name, number, body, ..args) => {",
            "    showybox(",
            "      frame: (",
            "        border-color: olive,",
            "        title-color: olive.lighten(30%),",
            "        body-color: olive.lighten(95%),",
            "        footer-color: olive.lighten(80%),",
            "      ),",
            "      title: [*Definition #number #if name not in (none, [], \"\") { [ (#name)] }*],",
            "      ..args.named(),",
            "      body,",
            "    )",
            "  },",
            ").with(numbering: \"1\")",
            "",
            "#let corollary = thmenv(",
            "  \"Corollary\",",
            "  none,",
            "  none,",
            "  (name, number, body, ..args) => {",
            "    showybox(",
            "      frame: (",
            "        border-color: purple,",
            "        title-color: purple.lighten(30%),",
            "        body-color: purple.lighten(95%),",
            "        footer-color: purple.lighten(80%),",
            "      ),",
            "      title: [*Corollary #number #if name not in (none, [], \"\") { [ (#name)] }*],",
            "      ..args.named(),",
            "      body,",
            "    )",
            "  },",
            ").with(numbering: \"1\")",
            "",
            "#let proof = thmproof(\"proof\", \"Proof\")"
        ]
    }
}
