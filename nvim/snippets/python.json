{
    "plt": {
        "prefix": "plt",
        "body": [
            "import matplotlib.pyplot as plt",
            "",
            "plt.rcParams.update(",
            "    {",
            "        # general",
            "        \"figure.figsize\": (6, 4),",
            "        \"figure.dpi\": 600,",
            "        \"figure.constrained_layout.use\": True,",
            "        # font",
            "        \"font.family\": \"Arial\",",
            "        \"font.size\": 16,",
            "        \"pdf.fonttype\": 42,",
            "        \"ps.fonttype\": 42,",
            "        \"mathtext.fontset\": \"dejavusans\",",
            "        \"axes.labelsize\": 14,",
            "        \"axes.titlesize\": 14,",
            "        \"legend.fontsize\": 14,",
            "        \"xtick.labelsize\": 12,",
            "        \"ytick.labelsize\": 12,",
            "        # lines",
            "        \"lines.linewidth\": 1.0,",
            "        \"lines.markersize\": 2,",
            "        # axes",
            "        \"axes.linewidth\": 1.0,",
            "        \"xtick.direction\": \"out\",",
            "        \"ytick.direction\": \"out\",",
            "        \"xtick.top\": False,",
            "        \"ytick.right\": False,",
            "        # grid",
            "        \"axes.grid\": True,",
            "        \"grid.linestyle\": \"--\",",
            "        \"grid.linewidth\": 0.5,",
            "        \"grid.alpha\": 0.8,",
            "        # legend",
            "        \"legend.frameon\": False,",
            "        \"legend.loc\": \"best\",",
            "        # savefig",
            "        \"savefig.dpi\": 600,",
            "        \"savefig.bbox\": \"tight\",",
            "    }",
            ")",
            "",
            "$0"
        ]
    }
