{
  "ui_font_family": ".SystemUIFont",
  "theme": "Neovim",
  "icon_theme": "Material Icon Theme",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "features": {
    "edit_prediction_provider": "copilot",
  },
  "vim_mode": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 200,
    },
  },
  "tabs": {
    "git_status": true,
  },
  "minimap": {
    "show": "auto",
  },
  "inlay_hints": {
    "enabled": true,
    "show_background": false,
    "edit_debounce_ms": 200,
    "scroll_debounce_ms": 0,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "terminal": {
    "shell": {
      "program": "zsh",
    },
    "cursor_shape": "bar",
    "copy_on_select": true,
    "keep_selection_on_copy": true,
  },
  "auto_install_extensions": {
    "material-icon-theme": true,
    "one-dark-pro": true,
    "git-firefly": true,
  },
  "languages": {
    "Markdown": {
      "format_on_save": "on",
      "use_on_type_format": false,
      "allow_rewrap": "anywhere",
      "soft_wrap": "editor_width",
      "completions": {
        "words": "enabled",
      },
      "prettier": {
        "allowed": true,
      },
    },
    "Python": {
      "language_servers": ["ty", "!basedpyright", "ruff"],
      "formatter": [
        {
          "code_action": "source.organizeImports.ruff",
        },
        {
          "code_action": "source.fixAll.ruff",
        },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
  },
}
