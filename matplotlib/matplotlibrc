# LINES
lines.linewidth: 1.0

# AXES
axes.grid: True
axes.prop_cycle: cycler(color='petroff6')

# GRIDS
grid.linestyle: --
grid.linewidth: 0.5
grid.alpha: 0.5

# LEGEND
legend.frameon: False

# FIGURE
figure.dpi: 600
figure.constrained_layout.use: True

# SAVING FIGURES
savefig.format: pdf
savefig.bbox: tight
pdf.fonttype: 42
